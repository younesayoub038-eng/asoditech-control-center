// ASODITECH Control Center — core domain schema.
// See docs/adr/0002-domain-model.md for the reasoning behind these boundaries.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the pooled connection (PgBouncer, e.g. Supabase's :6543)
// used by the app at runtime — required on serverless hosts like Vercel to
// avoid exhausting Postgres connections. DIRECT_URL is the unpooled
// connection (:5432) Prisma Migrate needs to run DDL reliably. Locally,
// both can point at the same local Postgres instance — see .env.example.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth: staff users + server-side sessions (see docs/adr/0003-auth-and-sessions.md)
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(ADMIN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  sessions       Session[]
  clientsCreated Client[]     @relation("ClientCreatedBy")
  paymentsRecord Payment[]    @relation("PaymentRecordedBy")
  auditEvents    AuditEvent[] @relation("AuditActorUser")

  @@map("users")
}

// Opaque, server-verified session tokens. Only the SHA-256 hash of the raw
// token is stored so a leaked database dump cannot be replayed as a cookie.
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())
  userAgent    String?
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id           String       @id @default(cuid())
  companyName  String
  contactName  String?
  email        String?
  phone        String?
  whatsapp     String?
  status       ClientStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?

  createdBy     User?          @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  instances     Instance[]
  subscriptions Subscription[]
  payments      Payment[]

  @@index([status])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Products — ASODITECH software products, deliberately generic so a future
// SaaS product fits without schema changes (see docs/adr/0002-domain-model.md)
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  DEPRECATED
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  status         ProductStatus @default(ACTIVE)
  currentVersion String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  instances Instance[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// Instances — one deployed installation of a Product for a Client. This is
// the entity that authenticates against the licensing endpoint.
// ---------------------------------------------------------------------------

enum InstanceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

model Instance {
  id        String          @id @default(cuid())
  clientId  String
  productId String
  label     String
  url       String?
  version   String?
  status    InstanceStatus  @default(PROVISIONING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Licensing credential: only a SHA-256 hash is persisted. The raw secret is
  // shown to the operator exactly once, at creation/rotation time.
  licenseKeyHash          String    @unique
  licenseKeyPrefix        String
  licenseKeyRotatedAt     DateTime  @default(now())
  licenseKeyLastVerifiedAt DateTime?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@map("instances")
}

// ---------------------------------------------------------------------------
// Subscriptions — the commercial relationship funding an Instance.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

model Subscription {
  id               String              @id @default(cuid())
  clientId         String
  instanceId       String
  planName         String
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @db.Char(3)
  billingInterval  BillingInterval
  startDate        DateTime
  nextPaymentDate  DateTime?
  status           SubscriptionStatus  @default(ACTIVE)
  cancelledAt      DateTime?
  suspendedAt      DateTime?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  instance Instance  @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([clientId])
  @@index([instanceId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Payments — historical financial record. Never deleted; status/refund
// tracked via PaymentStatus so the ledger stays truthful.
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  MOBILE_MONEY
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  clientId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @db.Char(3)
  paymentDate    DateTime
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod
  referenceId    String?
  notes          String?
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. Application code must never expose update/delete
// operations for this model.
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  INSTANCE
}

model AuditEvent {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorUserId String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime       @default(now())

  actorUser User? @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
