DATABASE_URL="postgresql://user:password@localhost:5432/asoditech_control_center?schema=public"

# Prisma Migrate uses DIRECT_URL (unpooled) to run DDL. Locally this can be
# identical to DATABASE_URL. In production (e.g. Supabase + Vercel),
# DATABASE_URL should be the pooled connection (PgBouncer, port 6543) and
# DIRECT_URL the direct one (port 5432) — see docs/adr/0001-tech-stack.md.
DIRECT_URL="postgresql://user:password@localhost:5432/asoditech_control_center?schema=public"

# Pepper mixed into session-token hashing. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

NODE_ENV="development"
